# Server Configuration
NODE_ENV=development
PORT=3000

# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# SDU Upstream Endpoint (optional, defaults to empty or local mock)
SDU_FLEET_CHART_URL=

# Token Pricing Configuration
GECKOTERMINAL_WPAC_TOKEN=
GECKOTERMINAL_NETWORK=bsc
FLARES_PREZZI_BATCH_URL=https://flaresplay.xyz/api/prezzi-batch

# Transaction Signing Guard (Security)
TX_SIGNING_STORE_DIR=cache/security/tx-signing-requests
TX_SIGNING_MAX_WALLET_TIP_LAMPORTS=2000000

# Auth Configuration
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRY_SECONDS=604800
ALLOWED_WALLETS=
